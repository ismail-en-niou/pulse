<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain net10.0 (not -windows) so the macOS CI runner can build it too; Windows-only code is marked [SupportedOSPlatform]. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulse.Core\Pulse.Core.csproj" />
  </ItemGroup>

</Project>
